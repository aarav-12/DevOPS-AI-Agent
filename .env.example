# GitHub — used by tools/github_tools.py (get_recent_commits, get_pr_status,
# get_workflow_run). Generate a fine-grained personal access token with
# ONLY "Contents: Read" and "Actions: Read" (repo + workflow, read-only)
# scopes. If this token leaks, the blast radius is "attacker can read
# code", not "attacker can delete the org".
GITHUB_TOKEN=ghp_your_token_here

# Kubernetes — tools/k8s_tools.py uses your local kubeconfig
# (~/.kube/config) automatically via get_k8s_clients(); no env var
# needed for local/dev use. When deployed inside a cluster it falls
# back to the pod's in-cluster service account instead.

# Jira — used by tools/jira_slack_tools.py (get_ticket_status,
# create_jira_ticket, add_jira_comment). Generate an API token scoped to
# a single project if your Jira instance supports it; otherwise use a
# dedicated bot/service account rather than a personal one.
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_EMAIL=bot@your-domain.com
JIRA_API_TOKEN=your_jira_api_token_here

# Slack — used by tools/jira_slack_tools.py (post_slack_message,
# post_incident_alert). Bot token scopes: chat:write only for now —
# don't request channels:history until a tool actually reads history.
# Least privilege: this bot can post messages, nothing else.
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
